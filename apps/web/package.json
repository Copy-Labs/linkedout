{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:edge": "wrangler dev --port 8787",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "deploy:edge": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "deploy:convex": "convex deploy"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@workspace/ui": "workspace:*",
    "convex": "^1.51.0",
    "hono": "^4.13.21",
    "posthog-js": "^1.454.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
