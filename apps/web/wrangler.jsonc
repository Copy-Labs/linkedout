{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedout-edge",
  "account_id": "fbf8c1829899eeae75e71f74e4535a04",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "secrets": {
    "required": ["WORKER_SECRET", "ADMIN_SECRET", "TURNSTILE_SECRET_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "CONVEX_URL": "https://original-parakeet-972.convex.cloud",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_EXPECTED_HOSTNAME": "",
    "TURNSTILE_EXPECTED_ACTION": ""
  },
  "env": {
    "production": {
      "name": "linkedout-edge",
      "main": "worker/index.ts",
      "compatibility_date": "2026-11-24",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": false },
      "secrets": {
        "required": ["WORKER_SECRET", "ADMIN_SECRET", "TURNSTILE_SECRET_KEY"]
      },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "vars": {
        "CONVEX_URL": "https://notable-aardvark-591.convex.cloud",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGRdmXoatXBOsOyN",
        "TURNSTILE_EXPECTED_HOSTNAME": "linkedout-edge.linkedout-fbf.workers.dev",
        "TURNSTILE_EXPECTED_ACTION": "submit"
      }
    }
  }
}
